# Porta da aplicação (padrão: 3001)
PORT=3001
NODE_ENV=production

# String de conexão do banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/principal

# URL do serviço NLPMARIANA (se estiver no mesmo host docker, use o nome do host/container)
NLP_API_URL=http://localhost:3000/consultar

# Tokens autorizados a acessar a API, separados por vírgula.
# Cada máquina autorizada deve usar um token único e seguro.
ALLOWED_TOKENS=seu-token-secreto-aqui
